{
  "name": "botpasses-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build && node scripts/write-sitemap.mjs && node scripts/write-conventional.mjs && pagefind --site dist --output-path dist/pagefind",
    "og": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/og.mjs",
    "icons": "node scripts/write-icons.mjs",
    "preview": "astro preview --port 4321"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/inter": "^5.3.0",
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "pagefind": "1.5.2"
  }
}
