---
import "../styles/global.css";
import inter700 from "@fontsource/inter/files/inter-latin-700-normal.woff2?url";
import { BRAND_HEX, BRAND_HEX_LIGHT, cssVariables } from "../../../src/brand-visual.ts";
import {
  GITHUB,
  PRODUCT_TAGLINE,
  SITE_NAME,
  organizationLd,
  websiteLd,
} from "../lib/site-meta.ts";

interface Props {
  /** Bare page title. Base appends " · Botpasses". */
  title: string;
  /** Unique per page. Used for meta description and social cards. */
  description: string;
  noindex?: boolean;
  /** Full-width pages (the homepage) opt out of the running-text column. */
  wide?: boolean;
  ogType?: "website" | "article";
  /** Trail after Home, JSON-LD only. */
  crumbs?: { href: string; label: string }[];
}

const { title, description, noindex = false, wide = false, ogType = "website", crumbs } = Astro.props;
const fullTitle = `${title} · ${SITE_NAME}`;
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/^\/index$/, "/");
const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://botpasses.com";
const canonical = new URL(path, `${site}/`).toString();
const ogImage = new URL("/og.png", `${site}/`).toString();
const ogSquare = new URL("/og-square.png", `${site}/`).toString();
const llms = new URL("/llms.txt", `${site}/`).toString();
const llmsFull = new URL("/llms-full.txt", `${site}/`).toString();
// One token source for site and console: src/brand-visual.ts.
const tokens = cssVariables().replace(/\s+/g, " ");

const breadcrumbLd = crumbs && crumbs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        ...crumbs.map((c, i) => ({
          "@type": "ListItem",
          position: i + 2,
          name: c.label,
          item: `${site}${c.href}`,
        })),
      ],
    }
  : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    <meta name="theme-color" content={BRAND_HEX.bg} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={BRAND_HEX_LIGHT.bg} media="(prefers-color-scheme: light)" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/android-chrome-192x192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href={llms} title="LLM-readable site index" />
    <link rel="alternate" type="text/plain" href={llmsFull} title="LLM-readable full documentation" />
    <link rel="preload" href={inter700} as="font" type="font/woff2" crossorigin />
    <style set:html={tokens}></style>
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Botpasses. ${PRODUCT_TAGLINE}`} />
    <meta property="og:image" content={ogSquare} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={`Botpasses. ${PRODUCT_TAGLINE}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`Botpasses. ${PRODUCT_TAGLINE}`} />
    {noindex ? null : (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(organizationLd())} />
        <script type="application/ld+json" set:html={JSON.stringify(websiteLd())} />
      </>
    )}
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <nav class="primary" aria-label="Primary">
          <a class="brand" href="/"><img class="brand-mark-on-light" src="/mark.svg" alt="" width="32" height="32" /><img class="brand-mark-on-dark" src="/mark-on-dark.svg" alt="" width="32" height="32" /> botpasses</a>
          <a href="/docs">Docs</a>
          <a href="/security">Security</a>
          <a href={GITHUB} rel="noopener">GitHub</a>
          <a class="nav-cta" href="/sign-in">Sign in</a>
        </nav>
      </div>
    </header>
    <div class:list={["wrap", { wide }]}>
      <main id="content">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="Footer">
          <a href="/docs">Docs</a>
          <a href="/security">Security</a>
          <a href="/changelog">Changelog</a>
          <a href="/design">Design</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href={GITHUB} rel="noopener">GitHub</a>
          <a href="mailto:support@botpasses.com">Support</a>
          <a href="/docs/security/disclosure">Report a vulnerability</a>
        </nav>
        <p class="footer-note">MIT licensed. Free while in beta. Hosted at botpasses.com.</p>
      </div>
    </footer>
  </body>
</html>
