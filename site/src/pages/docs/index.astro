---
import { getCollection } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { groupBySection, toNavItems } from "../../lib/docs-nav.ts";

const groups = groupBySection(toNavItems(await getCollection("docs")));
---
<Docs
  title="Docs"
  description="Botpasses documentation: create an account, store a credential, connect Claude, Cursor, ChatGPT, or Grok over MCP, approve and revoke access, and read the MCP and HTTP references."
  href="/docs"
>
  <h1>Docs</h1>
  <p>
    Store your API keys in Botpasses, connect an agent, and approve its access. Botpasses
    makes the API calls with your keys and returns responses with secrets removed.
    Follow the quickstart to connect your first agent.
  </p>
  {groups.map((g) => (
    <section>
      <h2 id={`list-${g.section}`}>{g.label}</h2>
      <ul class="doc-list">
        {g.items.map((i) => (
          <li>
            <a href={i.href}>{i.title}<span>{i.description}</span></a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Docs>
