---
import Base from "../layouts/Base.astro";
import { BRAND_FONTS, BRAND_HEX } from "../../../src/brand-visual.ts";

const tokens = Object.entries(BRAND_HEX) as [keyof typeof BRAND_HEX, string][];
const cssName = (key: string) => `--${key.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`)}`;
---
<Base title="Design" description="Botpasses visual tokens, type, and mark. One source of truth shared by the marketing site and the console.">
  <h1>Design</h1>
  <p>
    The living style guide. Tokens come from <code>src/brand-visual.ts</code> in the repository and are
    rendered here and in the console from the same file. Hex is the source of truth.
  </p>
  <h2>Mark</h2>
  <p><img src="/favicon.svg" alt="Botpasses mark" width="48" height="48" /></p>
  <h2>Tokens</h2>
  <div class="swatches">
    {tokens.map(([name, hex]) => (
      <div class="swatch">
        <div class="chip" style={`background:${hex}`}></div>
        <strong>{cssName(name)}</strong>
        <div><code>{hex}</code></div>
      </div>
    ))}
  </div>
  <h2>Type</h2>
  <p>
    Display {BRAND_FONTS.display}. Body {BRAND_FONTS.body}. Mono {BRAND_FONTS.mono}. Self-hosted OFL files,
    no font service at runtime. Headings use the display face at 700; body text is 16 px with a 1.55 line
    height and a 68-character measure.
  </p>
  <h2>Shape</h2>
  <p>
    Cards use a 10 px radius, a 1 px <code>--line</code> border, and the elevated background. Buttons use an
    8 px radius and a 44 px minimum target. The primary button is the accent on the page background; other
    buttons are outlined. Links are underlined, not colour-only.
  </p>
  <div class="hero-actions">
    <a class="btn btn-primary" href="#top">Primary</a>
    <a class="btn" href="#top">Secondary</a>
    <span class="pill">Pill</span>
    <span class="pill pill-warn">Pending</span>
  </div>
</Base>
