---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

const entry = await getEntry("changelog", "changelog");
if (!entry) throw new Error("CHANGELOG.md was not loaded");
const { Content } = await render(entry);
---
<Base
  title="Changelog"
  description="Botpasses releases and upcoming changes."
  crumbs={[{ href: "/changelog", label: "Changelog" }]}
>
  <h1>Changelog</h1>
  <p>
    Release notes from
    <a href="https://github.com/naffis/botpasses/blob/dev/CHANGELOG.md" rel="noopener">CHANGELOG.md</a>
    with the newest changes first.
  </p>
  <Content />
</Base>
