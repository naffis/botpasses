# 32-byte master key as 64 hex characters. Generate with: vault init
# Prefer the env var in production-like setups. Never commit the real key.
VAULT_MASTER_KEY=

# Directory for vault.sqlite (and optional master.key file). Default: ~/.agent-vault
# VAULT_HOME=

# Actor name written to the audit log. Default: $USER or "operator"
# VAULT_ACTOR=operator
