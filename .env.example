# 32-byte master key as 64 hex characters. Generate with: vault init
# Prefer the env var in production-like setups. Never commit the real key.
VAULT_MASTER_KEY=

# Directory for vault.sqlite (and optional master.key file). Default: ~/.botpasses
# VAULT_HOME=

# Actor name written to the audit log. Default: $USER or "operator"
# VAULT_ACTOR=operator

# Hosted (Fly). Do not set VAULT_HOME when VAULT_MODE=hosted (process exits 78).
# VAULT_MODE=hosted
# VAULT_KEK=
# VAULT_KEK_WRAPPED=
# VAULT_KMS_KEY_ID=
# AWS_ROLE_ARN=
# VAULT_KEK_REQUIRE_KMS=0
# DATABASE_URL=
# DATABASE_URL_DIRECT=
# VAULT_SESSION_SECRET=
# VAULT_OIDC_PRIVATE_JWK=
# RESEND_API_KEY=
# Staging: Botpasses <noreply@staging.botpasses.com>
# Production: Botpasses <noreply@botpasses.com>
# VAULT_EMAIL_FROM=Botpasses <noreply@staging.botpasses.com>
# VAULT_PUBLIC_URL=https://staging.botpasses.com
# VAULT_USER_JWT=
# VAULT_APPROVAL_HMAC=
# SENTRY_DSN=
# VAULT_BOOTSTRAP_TOKEN=
# VAULT_DEPLOY_PLANE=staging
# VAULT_AGENTPASS=0
# VAULT_AUTH_MODE=test
