# Botpasses environment. Copy to .env for local work; never commit the real values.
#
# Required per plane (blank = not used on that plane):
#
# | Variable                 | Local CLI | Hosted staging/prod             | Purpose |
# | ------------------------ | --------- | ------------------------------- | ------- |
# | VAULT_MASTER_KEY         | required* | -                               | 32-byte key, 64 hex chars (*or $VAULT_HOME/master.key) |
# | VAULT_HOME               | optional  | must be unset (exit 78)         | sqlite dir, default ~/.botpasses |
# | VAULT_MODE               | -         | hosted                          | selects the Postgres kernel |
# | VAULT_DEPLOY_PLANE       | -         | required: staging | production  | which vault environments this Machine serves; refuses production items on staging. Unset is exit 78, never a silent production default |
# | VAULT_PUBLIC_URL         | -         | required, must match the plane  | https://staging.botpasses.com or https://botpasses.com |
# | FLY_APP_NAME             | -         | set by Fly                      | KMS EncryptionContext `app`; required when VAULT_KEK_WRAPPED is set; the only setting that makes Fly-Client-IP and Fly-Request-Id trusted (and implies VAULT_TRUST_PROXY for X-Forwarded-For) |
# | FLY_ALLOC_ID             | -         | set by Fly                      | marks a Fly Machine: `vault kek-wrap` and `vault kek-rotate` refuse to run there (operator laptop only) |
# | DATABASE_URL             | -         | required                        | Neon pooled (-pooler) URL used by the app at runtime |
# | DATABASE_URL_DIRECT      | -         | recommended                     | Neon direct URL. scripts/migrate.ts (release_command) and backup-prod.yml pg_dump use it; falls back to DATABASE_URL |
# | VAULT_KEK_WRAPPED        | -         | required after KMS cutover      | base64 KMS ciphertext of the platform KEK |
# | VAULT_KMS_KEY_ID         | -         | required with VAULT_KEK_WRAPPED | CMK ARN |
# | AWS_ROLE_ARN             | -         | required with VAULT_KEK_WRAPPED | Fly OIDC role; no static AWS keys |
# | VAULT_KEK_REQUIRE_KMS    | -         | 1 after cutover                 | refuse raw VAULT_KEK |
# | VAULT_KEK                | -         | pre-cutover fallback only       | raw 32-byte KEK; logs kek_raw_fallback on a plane |
# | VAULT_KEK_PREVIOUS_WRAPPED | -       | during a KEK rotation           | base64 KMS ciphertext of the KEK being retired; rows under it are re-wrapped on read |
# | VAULT_KEK_PREVIOUS       | -         | during a raw-KEK rotation       | raw form of the same; refused under VAULT_KEK_REQUIRE_KMS=1 |
# | VAULT_KEK_NEW            | laptop    | -                               | `vault kek-rotate` only: the raw KEK the running plane already has as current (docs/ops/kek-rotation.md); unset generates a fresh one |
# | VAULT_SESSION_SECRET     | -         | required, 32+ bytes             | operator cookie + CSRF signing |
# | VAULT_OIDC_PRIVATE_JWK   | -         | required                        | RS256 private JWK for the same-origin OAuth AS; signs every access token |
# | VAULT_OIDC_PREVIOUS_JWK  | -         | during a key rotation only      | the private JWK being rotated out: published in JWKS, verifies old tokens, never signs (docs/ops/oidc-key-rotation.md) |
# | RESEND_API_KEY           | -         | required to send mail           | sending-access key scoped to the plane domain |
# | VAULT_EMAIL_FROM         | -         | required with RESEND_API_KEY    | Botpasses <noreply@staging.botpasses.com> / <noreply@botpasses.com> |
# | VAULT_APPROVAL_HMAC      | -         | optional, 64 hex chars          | signs approval magic links; boot exits 78 on any other shape |
# | VAULT_BOOTSTRAP_TOKEN    | -         | optional, 32+ chars             | break-glass operator token; every use is logged (auth_bootstrap_used) |
# | VAULT_BOOTSTRAP_ALLOW_PLANE | -      | 1 only during a break-glass window | staging/production ignore VAULT_BOOTSTRAP_TOKEN unless this is 1; unset both afterwards |
# | SENTRY_DSN               | -         | recommended                     | exceptions go to the Sentry envelope endpoint; a plane without it logs sentry_dsn_missing at boot |
# | VAULT_TRUST_PROXY        | -         | 1 outside Fly                   | 1 = trust the last X-Forwarded-For hop for rate limits and logs (implied by FLY_APP_NAME); Fly-Client-IP is never trusted off Fly; otherwise the socket peer counts |
# | VAULT_TRUSTED_PROXY_CIDRS | -        | optional, comma-separated CIDRs | proxies whose CF-Connecting-IP is believed; unset = Cloudflare's published ranges, empty = none |
# | VAULT_BIND_HOST          | -         | optional, default 0.0.0.0       | listen address of the hosted process |
# | PORT / VAULT_PORT        | -         | optional, default 8788          | listen port (PORT wins; Fly sets it) |
# | VAULT_SITE_ROOT          | -         | optional                        | built Astro site dir, default ./site/dist; boot exits 78 if index.html is missing |
# | VAULT_AUTH_MODE          | tests     | refused (exit 78)               | test = header principals for the test suite only; the hosted process never installs them |
# | VAULT_PLAN_LIMITS_JSON   | -         | optional                        | overrides the free-tier plan limits, e.g. {"credentials":25,"agents":10,"members":3,"calls":5000,"orgs":10} |
# | VAULT_USER_JWT           | optional  | -                               | `vault mcp --user-jwt` access token |
# | VAULT_ACTOR              | optional  | -                               | local audit actor, default $USER |

# 32-byte master key as 64 hex characters. Generate with: vault init
VAULT_MASTER_KEY=

# Directory for vault.sqlite (and optional master.key file). Default: ~/.botpasses
# VAULT_HOME=

# Actor name written to the audit log. Default: $USER or "operator"
# VAULT_ACTOR=operator

# Hosted (Fly). Do not set VAULT_HOME when VAULT_MODE=hosted (process exits 78).
# VAULT_MODE=hosted
# VAULT_DEPLOY_PLANE=staging
# VAULT_PUBLIC_URL=https://staging.botpasses.com
# FLY_APP_NAME=botpasses-staging
# VAULT_BIND_HOST=0.0.0.0
# VAULT_PORT=8788
# VAULT_SITE_ROOT=./site/dist
# DATABASE_URL=postgres://...-pooler.../neondb?sslmode=require
# DATABASE_URL_DIRECT=postgres://.../neondb?sslmode=require
# VAULT_KEK=
# VAULT_KEK_WRAPPED=
# VAULT_KEK_PREVIOUS_WRAPPED=
# Laptop only, for `vault kek-rotate` after the new KEK is already deployed (see docs/ops/kek-rotation.md).
# VAULT_KEK_NEW=
# VAULT_KMS_KEY_ID=
# AWS_ROLE_ARN=
# VAULT_KEK_REQUIRE_KMS=0
# VAULT_SESSION_SECRET=
# VAULT_OIDC_PRIVATE_JWK=
# Set only while rotating the OIDC key; unset once every token signed by it has expired.
# VAULT_OIDC_PREVIOUS_JWK=
# RESEND_API_KEY=
# Staging: Botpasses <noreply@staging.botpasses.com>
# Production: Botpasses <noreply@botpasses.com>
# VAULT_EMAIL_FROM=Botpasses <noreply@staging.botpasses.com>
# VAULT_APPROVAL_HMAC=
# SENTRY_DSN=
# Trust the last X-Forwarded-For hop for client addresses behind your own proxy (Fly implies it and is the only
# place Fly-Client-IP counts). Leave unset when clients connect directly.
# VAULT_TRUST_PROXY=0
# Unset: Cloudflare's ranges. Empty: never read CF-Connecting-IP.
# VAULT_TRUSTED_PROXY_CIDRS=173.245.48.0/20,2606:4700::/32
# Plan limits (free tier unless set). Keys: credentials, agents, members, calls (per UTC month), orgs (owned per user).
# VAULT_PLAN_LIMITS_JSON={"credentials":25,"agents":10,"members":3,"calls":5000,"orgs":10}
# Break-glass only. On staging/production also set VAULT_BOOTSTRAP_ALLOW_PLANE=1 for the window, then unset both.
# VAULT_BOOTSTRAP_TOKEN=
# VAULT_BOOTSTRAP_ALLOW_PLANE=0
# Test suite only. Hosted boot exits 78 when it is set.
# VAULT_AUTH_MODE=test
# VAULT_USER_JWT=

# Local Postgres for the PG-gated tests (npm run test:pg):
# DATABASE_URL=postgres://vault:vault@localhost:5432/vault
