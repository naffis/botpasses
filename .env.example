# 32-byte master key as 64 hex characters. Generate with: vault init
# Prefer the env var in production-like setups. Never commit the real key.
VAULT_MASTER_KEY=

# Directory for vault.sqlite (and optional master.key file). Default: ~/.botpasses
# VAULT_HOME=

# Actor name written to the audit log. Default: $USER or "operator"
# VAULT_ACTOR=operator

# Hosted (Fly). Do not set VAULT_HOME when VAULT_MODE=hosted (process exits 78).
# VAULT_MODE=hosted
# VAULT_KEK=
# DATABASE_URL=
# DATABASE_URL_DIRECT=
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# CLERK_FRONTEND_API=
# RESEND_API_KEY=
# VAULT_EMAIL_FROM=Botpasses <noreply@mail.botpasses.ai>
# VAULT_PUBLIC_URL=https://staging.botpasses.ai
# VAULT_USER_JWT=
# VAULT_APPROVAL_HMAC=
# SENTRY_DSN=
# VAULT_BOOTSTRAP_TOKEN=
# VAULT_DEPLOY_PLANE=staging
# VAULT_AGENTPASS=0
# VAULT_AUTH_MODE=test
