{
  "name": "botpasses",
  "version": "0.5.0",
  "description": "Botpasses: named secrets injected into tools, never into the model or transcript.",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "botpasses": "./bin/vault.js",
    "vault": "./bin/vault.js"
  },
  "scripts": {
    "botpasses": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts",
    "vault": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts",
    "hosted": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/hosted/main.ts",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/cli.ts serve",
    "site:build": "npm --prefix site run build",
    "migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/migrate.ts",
    "pretest": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/pretest.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-reporter=spec test/*.test.ts",
    "test:smoke": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/console-smoke.test.ts",
    "test:coverage": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-coverage-lines=80 test/*.test.ts",
    "test:pg": "DATABASE_URL=${DATABASE_URL:-postgres://vault:vault@localhost:5432/vault} npm test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "botpasses",
    "agent",
    "vault",
    "grants",
    "mcp",
    "secrets"
  ],
  "homepage": "https://botpasses.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naffis/botpasses.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "eslint": "^10.9.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1123.0",
    "jose": "^6.2.10",
    "oidc-provider": "^9.12.0",
    "otpauth": "^9.5.1",
    "pg": "^8.23.0",
    "qr": "^0.7.0"
  }
}
